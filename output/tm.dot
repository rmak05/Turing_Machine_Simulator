digraph TuringMachine {
bgcolor="lightyellow";
  rankdir=LR;
  fontsize=14;
  node [shape=circle, fontname=Helvetica];

  subgraph cluster_legend {
    label="Legend";
    fontsize=15;
    style=dashed;
    margin=8;
    rank=sink;

    Lmove [label="L = Move Left", shape=plaintext, fontcolor=red];
    Rmove [label="R = Move Right", shape=plaintext, fontcolor=blue];
    Smove [label="S = Stay", shape=plaintext, fontcolor="#4c525c"];
    Curr [label="Current State", shape=circle, style=filled, fillcolor=lightgreen, fontsize=8];

    // Invisible edges for vertical stacking
    Lmove -> Rmove [style=invis];
    Rmove -> Smove [style=invis];
    Smove -> Curr  [style=invis];
  }
  4 [shape=doublecircle];
  start [shape=point];
  start -> 0;
  2 [style=filled, fillcolor=lightgreen];
  0 -> 1 [label="0 → x", color=blue];
  0 -> 3 [label="y → y", color=blue];
  1 -> 1 [label="0 → 0", color=blue];
  1 -> 2 [label="1 → y", color=red];
  1 -> 1 [label="y → y", color=blue];
  2 -> 2 [label="0 → 0", color=red];
  2 -> 0 [label="x → x", color=blue];
  2 -> 2 [label="y → y", color=red];
  3 -> 4 [label="  →  ", color="#4c525c"];
  3 -> 3 [label="y → y", color=blue];
}
